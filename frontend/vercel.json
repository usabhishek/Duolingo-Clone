{
  "framework": "nextjs",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://linguaquest-api.onrender.com/api/:path*"
    }
  ],
  "env": {
    "NEXT_PUBLIC_API_URL": "https://linguaquest-api.onrender.com",
    "NEXT_PUBLIC_WS_URL": "wss://linguaquest-api.onrender.com"
  }
}
