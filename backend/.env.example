# Copy this to .env for local development

# Database — SQLite for local, Render auto-sets this to PostgreSQL in production
DATABASE_URL=sqlite:///./data/linguaquest.db

# JWT — change this to a long random string in production
JWT_SECRET_KEY=change-me-to-a-long-random-secret

# CORS — add your Vercel URL here after deploying frontend
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional Redis (rate limiting, WebSocket pub/sub)
# REDIS_URL=redis://localhost:6379/0

# Optional Google OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
